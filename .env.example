# Optional Gemini advisory only. The deterministic allocation engine never needs a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional services (leave blank for local in-memory demo/API)
POSTGRES_USER=mirage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mirage
DATABASE_URL=
REDIS_URL=

# Optional simulation configuration
MIRAGE_SEED=101
NEXT_PUBLIC_API_URL=http://localhost:8000
